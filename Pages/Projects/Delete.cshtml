@page "{id:int}"
@model Software_Modelling_Technologies.Pages.Projects.DeleteModel
@{
    ViewData["Title"] = "Delete project";
}

<div class="form-page narrow">
    <a asp-page="Index" class="back-link">← Back to projects</a>
    <div class="delete-card mt-4">
        <p class="eyebrow text-danger">Delete record</p>
        <h1>Delete project?</h1>
        <p class="text-muted">This will permanently remove <strong>@Model.Project.Title</strong> and its details.</p>
        <dl class="delete-summary">
            <dt>Author</dt><dd>@Model.Project.Author</dd>
            <dt>Status</dt><dd>@Model.Project.Status</dd>
            <dt>Technology stack</dt><dd>@Model.Project.TechnologyStack</dd>
        </dl>
        <form method="post" class="form-actions">
            <input type="hidden" asp-for="Project.Id" />
            <a asp-page="Index" class="btn btn-light">Cancel</a>
            <button type="submit" class="btn btn-danger">Delete project</button>
        </form>
    </div>
</div>
